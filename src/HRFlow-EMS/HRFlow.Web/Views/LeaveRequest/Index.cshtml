@using HRFlow.Common.Constants
@using HRFlow.Common.Enums
@using HRFlow.Web.Helpers
@model List<HRFlow.Business.DTOs.LeaveRequest.LeaveRequestListDto>

<div class="card">
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col">
                <h3 class="card-title mb-0">İzin Talepleri</h3>
            </div>


            <div class="col-auto">
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle"></i>
                    Yeni İzin Talebi
                </a>
            </div>

        </div>
    </div>

    <div class="card-body p-0">
        <table id="leaveRequestTable" class="table table-bordered table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>İzin Türü</th>
                    <th>Başlangıç</th>
                    <th>Bitiş</th>
                    <th>Durum</th>
                    <th>Toplam Gün</th>
                    <th class="text-center" style="width: 180px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FullName</td>
                        <td>@item.LeaveTypeName</td>
                        <td>@item.StartDate.ToString("dd.MM.yyyy")</td>
                        <td>@item.EndDate.ToString("dd.MM.yyyy")</td>
                        <td>@StatusDisplayHelper.GetText(item.Status)</td>
                        <td>@item.TotalDays</td>
                        <td class="text-center">
                            @if (User.IsInRole(Roles.Admin))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                    <i class="bi bi-pencil-square"></i>
                                    Düzenle
                                </a>
                            }
                            else if ((User.IsInRole(Roles.Manager) || User.IsInRole(Roles.HR)) && item.Status == LeaveStatus.Pending)
                            {
                                <form asp-action="Approve" method="post" class="d-inline approve-form">
                                    <input type="hidden" name="Id" value="@item.Id" />
                                    <button type="submit" class="btn btn-success btn-sm">Onayla</button>
                                </form>
                                <form asp-action="Reject" asp-route-id="@item.Id" method="post" class="d-inline reject-form">
                                    <button type="submit" class="btn btn-danger btn-sm">Reddet</button>
                                </form>
                                <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline cancel-form">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">İptal</button>
                                </form>
                            }
                            else if (User.IsInRole(Roles.Employee) && item.Status == LeaveStatus.Pending)
                            {
                                <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline cancel-form">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">İptal</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts
{
    <script>
        initializeDataTable('#leaveRequestTable', {
            columnDefs: [{ targets: 6, orderable: false }]
        });

        function confirmLeaveAction(selector, title, text, icon, confirmButtonText) {
            document.querySelectorAll(selector).forEach(form => {
                form.addEventListener('submit', function (event) {
                    event.preventDefault();

                    Swal.fire({
                        title: title,
                        text: text,
                        icon: icon,
                        showCancelButton: true,
                        confirmButtonText: confirmButtonText,
                        cancelButtonText: 'Vazgeç',
                        reverseButtons: true
                    }).then(result => {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });
        }

        confirmLeaveAction('.approve-form', 'Onaylıyor musunuz?', 'İzin talebi onaylanacaktır.', 'question', 'Evet, Onayla');
        confirmLeaveAction('.reject-form', 'Reddediyor musunuz?', 'İzin talebi reddedilecektir.', 'warning', 'Evet, Reddet');
        confirmLeaveAction('.cancel-form', 'İptal ediyor musunuz?', 'İzin talebi iptal edilecektir.', 'warning', 'Evet, İptal Et');
    </script>
}
