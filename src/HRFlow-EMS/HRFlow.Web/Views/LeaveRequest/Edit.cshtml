@model HRFlow.Business.DTOs.LeaveRequest.LeaveRequestUpdateDto

<div class="card-header">

    <h3 class="card-title">
        İzin Talebini Düzenle
    </h3>

</div>

<form asp-action="Edit" method="post">

    <input asp-for="Id" type="hidden" />
    <input asp-for="EmployeeId" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="card-body">

        <div class="mb-3">

            <label asp-for="LeaveTypeId"
                   class="form-label">

                İzin Türü

            </label>

            <select asp-for="LeaveTypeId"
                    asp-items="ViewBag.LeaveTypes"
                    class="form-select">

                <option value="">İzin Türü Seçiniz</option>

            </select>

            <span asp-validation-for="LeaveTypeId"
                  class="text-danger"></span>

        </div>

        <div class="row">

            <div class="col-md-6">

                <div class="mb-3">

                    <label asp-for="StartDate"
                           class="form-label">

                        Başlangıç Tarihi

                    </label>

                    <input asp-for="StartDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="StartDate"
                          class="text-danger"></span>

                </div>

            </div>

            <div class="col-md-6">

                <div class="mb-3">

                    <label asp-for="EndDate"
                           class="form-label">

                        Bitiş Tarihi

                    </label>

                    <input asp-for="EndDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="EndDate"
                          class="text-danger"></span>

                </div>

            </div>

        </div>

        <div class="mb-3">

            <label asp-for="Description"
                   class="form-label">

                Açıklama

            </label>

            <textarea asp-for="Description"
                      rows="4"
                      class="form-control"></textarea>

            <span asp-validation-for="Description"
                  class="text-danger"></span>

        </div>

        <div class="mb-3">

            <label asp-for="Status" class="form-label">Durum</label>

            <select asp-for="Status"
                    asp-items="Html.GetEnumSelectList<HRFlow.Common.Enums.LeaveStatus>()"
                    class="form-select">
            </select>

            <span asp-validation-for="Status" class="text-danger"></span>

        </div>

    </div>

    <div class="card-footer">

        <button type="submit"
                class="btn btn-warning">

            <i class="bi bi-floppy"></i>
            Güncelle

        </button>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Vazgeç

        </a>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
