@model HRFlow.Business.DTOs.Employee.EmployeeDetailDto
@{ var imagePath = string.IsNullOrWhiteSpace(Model.ProfileImagePath) ? "/adminlte/dist/assets/img/user2-160x160.jpg" : Model.ProfileImagePath; }
<h2>Çalışan Detayı</h2>
<div class="card"><div class="card-body">
    <div class="row g-4"><div class="col-md-3 text-center"><img src="@imagePath" alt="@Model.FirstName @Model.LastName" class="img-circle" style="width:150px;height:150px;object-fit:cover;" /></div><div class="col-md-9">
        <h4>Kişisel Bilgiler</h4><div class="row g-3"><div class="col-md-4"><b>Ad:</b> @Model.FirstName</div><div class="col-md-4"><b>Soyad:</b> @Model.LastName</div><div class="col-md-4"><b>Doğum Tarihi:</b> @Model.BirthDate?.ToString("dd.MM.yyyy")</div><div class="col-md-4"><b>Telefon Numarası:</b> @Model.PhoneNumber</div><div class="col-md-4"><b>Kişisel E-posta:</b> @Model.PersonalEmail</div></div>
        <hr /><h4>Adres Bilgileri</h4><div class="row g-3"><div class="col-md-4"><b>Adres:</b> @Model.Address</div><div class="col-md-3"><b>Şehir:</b> @Model.City</div><div class="col-md-3"><b>İlçe:</b> @Model.District</div><div class="col-md-2"><b>Posta Kodu:</b> @Model.PostalCode</div></div>
        <hr /><h4>Çalışma Bilgileri</h4><div class="row g-3"><div class="col-md-3"><b>Departman:</b> @Model.DepartmentName</div><div class="col-md-3"><b>Pozisyon:</b> @Model.PositionName</div><div class="col-md-3"><b>İşe Başlama Tarihi:</b> @Model.HireDate.ToString("dd.MM.yyyy")</div><div class="col-md-3"><b>Şirket E-postası:</b> @Model.Email</div></div>
    </div></div>
</div></div>
