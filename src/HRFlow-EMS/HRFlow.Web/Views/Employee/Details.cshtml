@model HRFlow.Business.DTOs.Employee.EmployeeDetailDto
@{ var imagePath = string.IsNullOrWhiteSpace(Model.ProfileImagePath) ? "/adminlte/dist/assets/img/user2-160x160.jpg" : Model.ProfileImagePath; }
<h2>Çalışan Detayı</h2>
<div class="card"><div class="card-body">
    <div class="row g-4"><div class="col-md-3 text-center"><img src="@imagePath" alt="@Model.FirstName @Model.LastName" class="img-circle" style="width:150px;height:150px;object-fit:cover;" /></div><div class="col-md-9">
        <h4>Personal Information</h4><div class="row g-3"><div class="col-md-4"><b>First Name:</b> @Model.FirstName</div><div class="col-md-4"><b>Last Name:</b> @Model.LastName</div><div class="col-md-4"><b>Birth Date:</b> @Model.BirthDate?.ToString("dd.MM.yyyy")</div><div class="col-md-4"><b>Phone Number:</b> @Model.PhoneNumber</div><div class="col-md-4"><b>Personal Email:</b> @Model.PersonalEmail</div></div>
        <hr /><h4>Address Information</h4><div class="row g-3"><div class="col-md-4"><b>Address:</b> @Model.Address</div><div class="col-md-3"><b>City:</b> @Model.City</div><div class="col-md-3"><b>District:</b> @Model.District</div><div class="col-md-2"><b>Postal Code:</b> @Model.PostalCode</div></div>
        <hr /><h4>Employment Information</h4><div class="row g-3"><div class="col-md-3"><b>Department:</b> @Model.DepartmentName</div><div class="col-md-3"><b>Position:</b> @Model.PositionName</div><div class="col-md-3"><b>Hire Date:</b> @Model.HireDate.ToString("dd.MM.yyyy")</div><div class="col-md-3"><b>Company Email:</b> @Model.Email</div></div>
    </div></div>
</div></div>
