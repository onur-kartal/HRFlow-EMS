@model List<HRFlow.Business.DTOs.Employee.EmployeeListDto>
@using HRFlow.Common.Helpers

<div class="card-header">
    <div class="row align-items-center">

        <div class="col">
            <h3 class="card-title mb-0">Personeller</h3>
        </div>

        <div class="col-auto">
            @if (PermissionHelper.CanManageEmployees(User))
            {
                <a asp-action="Create"
                   class="btn btn-primary btn-sm">

                    <i class="bi bi-plus-circle"></i>

                    Yeni Personel

                </a>
            }
        </div>

    </div>
</div>

<div class="card-body p-0">

    <table id="employeeTable" class="table table-bordered table-striped table-hover align-middle">

        <thead>
            <tr>
                <th>Ad Soyad</th>
                <th>Departman</th>
                <th>Pozisyon</th>
                <th>Kullanıcı</th>
                <th class="text-center" style="width:180px;">İşlemler</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.FullName</td>

                    <td>@item.DepartmentName</td>

                    <td>@item.PositionName</td>

                    <td>
                        @if (!item.HasUser)
                        {
                            <span class="badge bg-danger">
                                Yok
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                @item.UserRole
                            </span>

                        }
                    </td>

                    <td class="text-center">

                        @if (PermissionHelper.CanManageEmployees(User))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm me-1">

                                <i class="bi bi-pencil-square"></i>

                                Düzenle

                            </a>
                        }

                        <form asp-action="Delete"
                              asp-route-id="@item.Id"
                              method="post"
                              class="d-inline delete-form">

                            @if (PermissionHelper.CanDeleteEmployee(User))
                            {
                                <button type="submit"
                                        class="btn btn-danger btn-sm">

                                    <i class="bi bi-trash"></i>
                                    Sil

                                </button>
                            }
                        </form>

                        @if (!item.HasUser)
                        {
                            @if (PermissionHelper.CanCreateUser(User))
                            {
                                <a asp-action="CreateUser"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-success mt-1">

                                    <i class="bi bi-person-plus-fill"></i>
                                    Kullanıcı Oluştur

                                </a>
                            }
                        }
                        else
                        {
                            @if (PermissionHelper.CanChangeRole(User))
                            {
                                <a asp-action="ChangeRole"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-warning mt-1">

                                    <i class="bi bi-person-gear"></i>
                                    Rol Değiştir

                                </a>
                            }
                        }

                    </td>



                </tr>
            }


        </tbody>

    </table>

    <div id="modalContainer"></div>
</div>


@section Scripts
{
    <script>
        initializeDataTable('#employeeTable', {

            columnDefs: [

                { width: "35%", targets: 0 },

                { width: "25%", targets: 1 },

                { width: "25%", targets: 2 },

                {
                    width: "15%",
                    targets: 3,
                    orderable: false
                }

            ]

        });
        document.querySelectorAll(".delete-form").forEach(form => {

            form.addEventListener("submit", function (e) {

                e.preventDefault();

                Swal.fire({
                    title: "Emin misiniz?",
                    text: "Bu çalışan silinecek.",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Evet, Sil",
                    cancelButtonText: "İptal",
                    reverseButtons: true
                }).then((result) => {

                    if (result.isConfirmed) {
                        form.submit();
                    }

                });

            });

        });
    </script>
}