@model List<HRFlow.Business.DTOs.Logging.RequestLogListDto>
<div class="card"><div class="card-header"><h3 class="card-title mb-0">Request Log</h3></div><div class="card-body p-0"><table id="requestLogTable" class="table table-bordered table-striped table-hover align-middle mb-0"><thead><tr><th>Tarih</th><th>Kullanıcı</th><th>Rol</th><th>Method</th><th>Path</th><th>Durum</th><th>Süre (ms)</th><th>IP</th><th>Browser</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td><td>@item.UserName</td><td>@item.Role</td><td>@item.HttpMethod</td><td>@item.RequestPath</td><td>@item.StatusCode</td><td>@item.DurationMs</td><td>@item.IpAddress</td><td>@item.Browser</td></tr>}</tbody></table></div></div>
@section Scripts { <script>initializeDataTable('#requestLogTable');</script> }
