@model HRFlow.Business.DTOs.Payroll.PayrollPeriodCreateDto

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Yeni Bordro Dönemi</h3>
    </div>

    <form method="post">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Year">Yıl</label>
                    <input asp-for="Year" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Month">Ay</label>
                    <input asp-for="Month" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="StartDate">Başlangıç</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="EndDate">Bitiş</label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                </div>
            </div>
        </div>

        <div class="card-footer text-end">
            <button class="btn btn-primary">Kaydet</button>
        </div>
    </form>
</div>
