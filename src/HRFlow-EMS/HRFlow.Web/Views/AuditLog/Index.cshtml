@model List<HRFlow.Business.DTOs.Logging.AuditLogListDto>
<div class="card"><div class="card-header"><h3 class="card-title mb-0">Audit Log</h3></div><div class="card-body p-0"><table id="auditLogTable" class="table table-bordered table-striped table-hover align-middle mb-0"><thead><tr><th>Tarih</th><th>Kullanıcı</th><th>Rol</th><th>Modül</th><th>İşlem</th><th>Entity Id</th><th>Açıklama</th><th>IP</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td><td>@item.UserName</td><td>@item.Role</td><td>@item.Module</td><td>@item.Action</td><td>@item.EntityId</td><td>@item.Description</td><td>@item.IpAddress</td></tr>}</tbody></table></div></div>
@section Scripts { <script>initializeDataTable('#auditLogTable');</script> }
