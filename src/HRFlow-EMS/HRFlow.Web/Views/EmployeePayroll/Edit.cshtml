@model HRFlow.Business.DTOs.Payroll.EmployeePayrollUpdateDto

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Bordro Düzenle</h3>
    </div>

    <form method="post">
        <input asp-for="Id" type="hidden" />

        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Bonus">Prim</label>
                    <input asp-for="Bonus" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Deduction">Kesinti</label>
                    <input asp-for="Deduction" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="PaymentDate">Ödeme Tarihi</label>
                    <input asp-for="PaymentDate" type="date" class="form-control" />
                </div>
            </div>
        </div>

        <div class="card-footer text-end">
            <button class="btn btn-primary">Kaydet</button>
        </div>
    </form>
</div>
