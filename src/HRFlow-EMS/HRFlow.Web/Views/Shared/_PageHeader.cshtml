@model HRFlow.Web.Helpers.PageMetadata

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="mb-0 fs-3">@Model.Title</h1>
            </div>
            <div class="col-sm-6">
                <nav aria-label="Sayfa yolu">
                    <ol class="breadcrumb float-sm-end">
                        @if (Model.IsDashboard)
                        {
                            <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
                        }
                        else
                        {
                            <li class="breadcrumb-item">
                                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>

                            @if (!string.IsNullOrWhiteSpace(Model.Section))
                            {
                                <li class="breadcrumb-item">@Model.Section</li>
                            }

                            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
                        }
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
