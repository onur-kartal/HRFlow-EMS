                      User.IsInRole(Roles.Manager) ? Roles.Manager :
                      Roles.Employee;
    var profileImagePath = string.IsNullOrWhiteSpace(Model?.ProfileImagePath)
        ? Url.Content("~/adminlte/dist/assets/img/user2-160x160.jpg")
        : Model.ProfileImagePath;
}

