@using HRFlow.Common.Constants
@using HRFlow.Web.Helpers
@model HRFlow.Web.Models.Notification.NotificationNavbarViewModel

@{
    var currentRole = User.IsInRole(Roles.Admin) ? Roles.Admin :
                      User.IsInRole(Roles.HR) ? Roles.HR :
                      User.IsInRole(Roles.Manager) ? Roles.Manager :
                      Roles.Employee;
    var profileImagePath = string.IsNullOrWhiteSpace(Model.Profile?.ProfileImagePath)
        ? Url.Content("~/adminlte/dist/assets/img/user2-160x160.jpg")
        : Model.Profile.ProfileImagePath;
}

<ul class="navbar-nav">
    <li class="nav-item">
        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Yan menüyü aç/kapat">
            <i class="bi bi-list"></i>
        </a>
    </li>
</ul>
<ul class="navbar-nav ms-auto">
    <li class="nav-item dropdown">
        <a class="nav-link" data-bs-toggle="dropdown" href="#" aria-label="Bildirimler">
            <i class="bi bi-bell-fill"></i>
            @if (Model.NotificationSummary.UnreadCount > 0)
            {
                <span class="navbar-badge badge text-bg-warning">@Model.NotificationSummary.UnreadCount</span>
            }
        </a>
        <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
            <span class="dropdown-item dropdown-header">@Model.NotificationSummary.UnreadCount okunmamış bildirim</span>
            @if (Model.NotificationSummary.Notifications.Count == 0)
            {
                <span class="dropdown-item text-secondary">Bildirim bulunmuyor.</span>
            }
            else
            {
                @foreach (var notification in Model.NotificationSummary.Notifications)
                {
                    <div class="dropdown-divider"></div>
                    <a asp-controller="Notification" asp-action="Open" asp-route-id="@notification.Id" class="dropdown-item @(notification.IsRead ? string.Empty : "bg-body-tertiary")">
                        <i class="bi @NotificationDisplayHelper.GetIcon(notification.NotificationType) @NotificationDisplayHelper.GetTextClass(notification.NotificationType) me-2"></i>
                        <span class="@(notification.IsRead ? string.Empty : "fw-semibold")">@notification.Title</span>
                        <span class="float-end text-secondary fs-7">@notification.CreatedDate.ToLocalTime().ToString("dd.MM HH:mm")</span>
                        <small class="d-block text-secondary text-truncate">@notification.Message</small>
                    </a>
                }
            }
            <div class="dropdown-divider"></div>
            <a asp-controller="Notification" asp-action="Index" class="dropdown-item dropdown-footer">Tüm Bildirimleri Gör</a>
        </div>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="#" data-lte-toggle="fullscreen" aria-label="Tam ekranı aç/kapat">
            <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
            <i data-lte-icon="minimize" class="bi bi-fullscreen-exit d-none"></i>
        </a>
    </li>
    <li class="nav-item dropdown">
        <a class="nav-link" href="#" id="bd-theme" aria-label="Renk temasını değiştir" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-sun-fill" data-lte-theme-icon="light"></i>
            <i class="bi bi-moon-fill d-none" data-lte-theme-icon="dark"></i>
            <i class="bi bi-circle-half d-none" data-lte-theme-icon="auto"></i>
        </a>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="bd-theme" style="--bs-dropdown-min-width: 8rem">
            <li><button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="light" aria-pressed="false"><i class="bi bi-sun-fill me-2"></i>Açık<i class="bi bi-check-lg ms-auto d-none"></i></button></li>
            <li><button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="dark" aria-pressed="false"><i class="bi bi-moon-fill me-2"></i>Koyu<i class="bi bi-check-lg ms-auto d-none"></i></button></li>
            <li><button type="button" class="dropdown-item d-flex align-items-center active" data-bs-theme-value="auto" aria-pressed="true"><i class="bi bi-circle-half me-2"></i>Otomatik<i class="bi bi-check-lg ms-auto d-none"></i></button></li>
        </ul>
    </li>
    <li class="nav-item dropdown user-menu">
        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
            <img src="@profileImagePath" class="user-image rounded-circle shadow" alt="Kullanıcı" />
            <span class="d-none d-md-inline">@User.Identity?.Name</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
            <li class="user-header text-bg-primary">
                <img src="@profileImagePath" class="rounded-circle shadow" alt="Kullanıcı" />
                <p>@User.Identity?.Name <small>@currentRole · HRFlow EMS</small></p>
            </li>
            <li class="user-footer">
                <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary">Profil</a>
                <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger float-end">Çıkış Yap</a>
            </li>
        </ul>
    </li>
</ul>
