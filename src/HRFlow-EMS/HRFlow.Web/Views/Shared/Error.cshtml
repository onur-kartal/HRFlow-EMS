@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<h1 class="text-danger">Hata.</h1>
<h2 class="text-danger">İsteğiniz işlenirken bir hata oluştu.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>İstek Kimliği:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Geliştirme Modu</h3>
<p>
    <strong>Geliştirme</strong> ortamı, oluşan hata hakkında daha ayrıntılı bilgi gösterir.
</p>
<p>
    <strong>Geliştirme ortamı yayınlanan uygulamalarda etkin olmamalıdır.</strong>
    Bu ortam, hata ayrıntılarındaki hassas bilgilerin son kullanıcılara gösterilmesine neden olabilir.
</p>
