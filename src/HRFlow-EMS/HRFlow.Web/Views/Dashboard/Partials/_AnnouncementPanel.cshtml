@model List<HRFlow.Business.DTOs.Announcement.AnnouncementDashboardDto>

<div class="card mt-3">
    <div class="card-header">
        <h3 class="card-title fw-semibold">
            <i class="bi bi-megaphone-fill text-primary me-2"></i>
            Duyurular
        </h3>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var item in Model)
                {
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <h6 class="mb-1 fw-semibold">@item.Title</h6>
                                <p class="mb-0 small text-body-secondary">@item.Content</p>
                            </div>
                            <span class="small text-body-secondary text-nowrap">@item.StartDate.ToString("dd.MM.yyyy")</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4 text-body-secondary">
                <i class="bi bi-megaphone"></i>
                Aktif duyuru bulunmuyor.
            </div>
        }
    </div>
</div>
