@using HRFlow.Common.Constants
@model HRFlow.Web.Models.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

@if (User.IsInRole(Roles.Employee))
{
    <partial name="~/Views/Dashboard/Partials/_EmployeeDashboard.cshtml" model="Model.EmployeeDashboard" />
}
else if (User.IsInRole(Roles.Manager))
{
    <partial name="~/Views/Dashboard/Partials/_ManagerDashboard.cshtml" model="Model.ManagerDashboard" />
}
else if (User.IsInRole(Roles.HR))
{
    <partial name="~/Views/Dashboard/Partials/_HRDashboard.cshtml" model="Model.AdminHrDashboard" />
}
else
{
    <partial name="~/Views/Dashboard/Partials/_AdminDashboard.cshtml" model="Model.AdminHrDashboard" />
}
